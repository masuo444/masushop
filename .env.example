# 本番の値は Vercel のプロジェクト設定（Environment Variables）で管理する。
# このファイルには実際の値を書かないこと。

# サイトの公開URL（canonical・OGP・sitemapの生成に使う）
NEXT_PUBLIC_BASE_URL=https://masu.fomus.jp

# 問い合わせメール（Resend）
RESEND_API_KEY=
ADMIN_EMAIL=

# 問い合わせ内容の保存先（Vercel Blob）
BLOB_READ_WRITE_TOKEN=

# 計測。未設定ならタグを出力しないので、プレビュー環境では空のままでよい
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console のHTMLタグ認証に使う content の値
GOOGLE_SITE_VERIFICATION=

# 決済オプション
FEATURE_JPYC=
JPYC_WALLET_ADDRESS=
